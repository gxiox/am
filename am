    Color3.fromRGB(155, 55, 65)
)

local ModeLabel = makeLabel(
    "Purchase mode",
    UDim2.new(0, 15, 0, 49),
    UDim2.new(1, -30, 0, 22), Frame
)
ModeLabel.TextXAlignment = Enum.TextXAlignment.Left

local selected = "Both"

local CoinsBtn = makeButton(
    "COINS", UDim2.new(0, 15, 0, 78),
    UDim2.new(0, 82, 0, 36), Frame,
    Color3.fromRGB(48, 52, 68)
)

local GemsBtn = makeButton(
    "GEMS", UDim2.new(0, 104, 0, 78),
    UDim2.new(0, 82, 0, 36), Frame,
    Color3.fromRGB(48, 52, 68)
)

local BothBtn = makeButton(
    "BOTH", UDim2.new(0, 193, 0, 78),
