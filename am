makeLabel(
    "Repeat interval: 60 seconds",
    UDim2.new(0, 15, 0, 240),
    UDim2.new(1, -30, 0, 24), Frame
).TextColor3 = Color3.fromRGB(155, 165, 190)

--// Drag support
pcall(function()
    Frame.Draggable = true
end)

--// Mode selection
local function refreshMode()
    local active = Color3.fromRGB(65, 105, 190)
    local inactive = Color3.fromRGB(48, 52, 68)

    CoinsBtn.BackgroundColor3 =
        selected == "Coins" and active or inactive
    GemsBtn.BackgroundColor3 =
        selected == "Gems" and active or inactive
    BothBtn.BackgroundColor3 =
        selected == "Both" and active or inactive

    ModeStatus.Text = "Selected: " .. selected
end

CoinsBtn.Activated:Connect(function()
    selected = "Coins"
    refreshMode()
end)

GemsBtn.Activated:Connect(function()
    selected = "Gems"
    refreshMode()
end)

BothBtn.Activated:Connect(function()
    selected = "Both"
    refreshMode()
end)

--// Resolve Remote only when needed
local function buyItem(currency)
    local ok, result = pcall(function()
        local ReplicatedStorage =
            game:GetService("ReplicatedStorage")

        local remotes =
            ReplicatedStorage:WaitForChild("Remotes", 10)

        if not remotes then
            error("Remotes folder not found")
        end

        local event = remotes:WaitForChild("BuyItem", 10)
        if not event then
            error("BuyItem Remote not found")
        end

        return event:InvokeServer("Trait", 1, currency)
    end)

    if not ok then
        warn("[AutoBuy Trait] " .. currency .. ": " .. tostring(result))
        Status.Text = "Status: ERROR - check Console"
        Status.TextColor3 = Color3.fromRGB(255, 150, 100)
    end
end

local function purchaseSelected()
    local mode = selected

    if mode == "Coins" or mode == "Both" then
        buyItem("Coins")
    end

    if mode == "Gems" or mode == "Both" then
        buyItem("Gems")
    end
end

--// Auto loop
local running = false
local runId = 0

local function stopAuto()
    running = false
    runId += 1

    Status.Text = "Status: STOPPED"
    Status.TextColor3 = Color3.fromRGB(240, 130, 130)
    StartBtn.Text = "START AUTO BUY"
    StartBtn.BackgroundColor3 = Color3.fromRGB(35, 145, 95)
end

StartBtn.Activated:Connect(function()
    if running then
        stopAuto()
        return
    end

    running = true
    runId += 1
    local myRunId = runId

    Status.Text = "Status: RUNNING"
    Status.TextColor3 = Color3.fromRGB(100, 230, 155)
    StartBtn.Text = "STOP AUTO BUY"
    StartBtn.BackgroundColor3 = Color3.fromRGB(175, 60, 70)

    task.spawn(function()
        while running and runId == myRunId do
            purchaseSelected()

            for i = 1, 60 do
                if not running or runId ~= myRunId then
                    break
                end
                task.wait(1)
            end
        end
    end)
end)

Close.Activated:Connect(function()
    stopAuto()
    ScreenGui:Destroy()
end)

refreshMode()
print("[AutoBuy Trait] UI created successfully")
