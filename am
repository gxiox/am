
--// Auto Buy Trait UI - Cloud Phone UI Fix
--// Coins / Gems / Both
--// Repeat every 60 seconds

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer
if not Player then
    warn("[AutoBuy Trait] LocalPlayer not found")
    return
end

local GUI_NAME = "AutoBuyTraitUI"

--// Safely select GUI parent
local Parent
local gethuiFunc

pcall(function()
    gethuiFunc = gethui
end)

if type(gethuiFunc) == "function" then
    local ok, result = pcall(gethuiFunc)
    if ok and typeof(result) == "Instance" then
        Parent = result
    end
end

if not Parent then
    local ok, result = pcall(function()
        return Player:WaitForChild("PlayerGui", 10)
    end)
    if ok then
        Parent = result
    end
end

if not Parent then
    warn("[AutoBuy Trait] Cannot access GUI parent")
    return
end

--// Remove old UI
pcall(function()
    local old = Parent:FindFirstChild(GUI_NAME)
    if old then old:Destroy() end
end)

--// Create UI first; do not wait for Remote here
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = GUI_NAME
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.DisplayOrder = 999
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local guiOK, guiErr = pcall(function()
    ScreenGui.Parent = Parent
end)

if not guiOK then
    warn("[AutoBuy Trait] GUI parent error:", guiErr)
    return
end

local Frame = Instance.new("Frame")
Frame.Name = "Main"
Frame.Size = UDim2.new(0, 290, 0, 285)
Frame.Position = UDim2.new(0.5, -145, 0.5, -142)
Frame.BackgroundColor3 = Color3.fromRGB(22, 24, 32)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Visible = true
Frame.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Frame

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(75, 90, 125)
Stroke.Thickness = 1.3
Stroke.Parent = Frame

local function makeLabel(text, pos, size, parent)
    local obj = Instance.new("TextLabel")
    obj.Size = size
    obj.Position = pos
    obj.BackgroundTransparency = 1
    obj.Text = text
    obj.TextColor3 = Color3.fromRGB(240, 243, 255)
    obj.TextSize = 14
    obj.Font = Enum.Font.GothamMedium
    obj.Parent = parent
    return obj
end

local function makeButton(text, pos, size, parent, color)
    local obj = Instance.new("TextButton")
    obj.Size = size
    obj.Position = pos
    obj.BackgroundColor3 = color
    obj.BorderSizePixel = 0
    obj.Text = text
    obj.TextColor3 = Color3.fromRGB(255, 255, 255)
    obj.TextSize = 13
    obj.Font = Enum.Font.GothamBold
    obj.AutoButtonColor = true
    obj.Active = true
    obj.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = obj

    return obj
end

makeLabel(
    "AUTO BUY TRAIT",
    UDim2.new(0, 15, 0, 10),
    UDim2.new(1, -55, 0, 28),
    Frame
).TextSize = 18

local Close = makeButton(
    "×", UDim2.new(1, -38, 0, 9),
